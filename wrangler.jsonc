{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cfwforum-work",
	"main": "src/index.ts",
	"assets": {
		"directory": "./public"
	},
	"compatibility_date": "2025-09-27",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "cfwforum_db",
			"database_name": "cfwforum-data",
			"database_id": "*****************************",
			"remote": true,
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "cfworkforum-work"
		}
	],
	"workers_dev": true,
	"vars": {
		"WORKER_URL": "********************************",
		"JWT_SECRET": "********************************",
		"TURNSTILE_SITE_KEY": "********************************",
		"TURNSTILE_SECRET_KEY": "********************************",
		"RESEND_KEY": "********************************",
		"RESEND_FROM": "********************************",
		"RESEND_FROM_NAME": "********************************"
	},
	"env": {
		"development": {
			"vars": {
				"WORKER_URL": "http://localhost:8787"
			}
		}
	}
}
